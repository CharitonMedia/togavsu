{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Togavsu Marketplace API",
    "version": "1.0.0",
    "summary": "Read and operator contract for the separate marketplace service.",
    "description": "Proposal only. The core browses and polls this service. The operator does not review modules. Signing identifies the publisher. No production host is named here."
  },
  "servers": [
    {
      "url": "https://marketplace.example.invalid",
      "description": "Placeholder. Not a live host."
    }
  ],
  "paths": {
    "/v1/listings": {
      "get": {
        "operationId": "listListings",
        "summary": "Search listings. Pulled modules are omitted.",
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Listing"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/listings/{listing_id}": {
      "get": {
        "operationId": "getListing",
        "summary": "One listing, including a flag note when flagged.",
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Listing"
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [],
        "parameters": [
          {
            "name": "listing_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/listings/{listing_id}/versions/{version}/package": {
      "get": {
        "operationId": "getListingPackage",
        "summary": "Signed package for one listing version. The core asks with the listing id and that version. Missing listing or version is not_found. A pulled listing or a yanked version is yanked and returns no bytes. A digest mismatch, an invalid signature, or an untrusted key_id is a verification failure and returns no bytes. A network failure is unavailable. The body is the manifest, digest, signature, and key id. It is not a URL, and the core does not run it until those checks pass.",
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedPackage"
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "listing_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-togavsu-verification": {
          "before_execution": [
            "digest",
            "signature",
            "trusted_key",
            "immutable_version"
          ],
          "missing": "not_found",
          "yanked_or_pulled": "yanked",
          "digest_mismatch": "digest_mismatch",
          "signature_invalid": "signature_invalid",
          "untrusted_key": "untrusted_key",
          "network_failure": "unavailable",
          "artifact_url_is_install": false
        }
      }
    },
    "/v1/alerts": {
      "get": {
        "operationId": "listAlerts",
        "summary": "Flags and pulls for module ids the core asks about.",
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Alert"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "module_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ]
      }
    },
    "/v1/signing-keys": {
      "get": {
        "operationId": "listSigningKeys",
        "summary": "Publisher signing keys the core trusts from the marketplace.",
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "author",
                          "public_key_pem"
                        ],
                        "properties": {
                          "author": {
                            "type": "string"
                          },
                          "public_key_pem": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/operator/listings/{listing_id}/flag": {
      "post": {
        "operationId": "flagListing",
        "summary": "Operator flag. Installs stay possible. The required note is shown on the listing. version flags one version; omit it to flag the listing.",
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Listing"
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FlagRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "listing_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/operator/listings/{listing_id}/pull": {
      "post": {
        "operationId": "pullListing",
        "summary": "Operator pull. The listing leaves search and cannot be installed from the marketplace. A local file install remains possible.",
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Listing"
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "listing_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "FlagRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "note"
        ],
        "properties": {
          "note": {
            "type": "string",
            "minLength": 1,
            "description": "Shown on the listing and in the firm alert."
          },
          "version": {
            "type": "string",
            "description": "Optional. Omit to flag the listing. Set to flag one version."
          }
        }
      },
      "Listing": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "author",
          "signing_key",
          "version",
          "permissions",
          "version_history",
          "price_note",
          "flagged",
          "pulled",
          "notice"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "module_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "signing_key": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "version_history": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "released_at"
              ],
              "properties": {
                "version": {
                  "type": "string"
                },
                "released_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "price_note": {
            "type": "string"
          },
          "flagged": {
            "type": "boolean"
          },
          "flag_note": {
            "type": "string"
          },
          "pulled": {
            "type": "boolean"
          },
          "notice": {
            "type": "string"
          }
        }
      },
      "SignedPackage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "listing_id",
          "version",
          "immutable",
          "manifest",
          "digest",
          "signature",
          "key_id"
        ],
        "properties": {
          "listing_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "description": "The requested version. The marketplace does not substitute a later one."
          },
          "immutable": {
            "const": true
          },
          "manifest": {
            "type": "object",
            "description": "Signed module manifest. The core parses it only after the digest and signature verify."
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "signature": {
            "type": "string",
            "minLength": 1
          },
          "key_id": {
            "type": "string",
            "minLength": 1,
            "description": "Publisher key the core must already trust. A URL is not a signer."
          }
        },
        "description": "One immutable signed package. The core verifies the digest, signature, and key before any migration or process starts. This response is not an instruction to fetch or execute a URL."
      },
      "Alert": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module_id",
          "kind",
          "note"
        ],
        "properties": {
          "module_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "flag",
              "pull"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "code",
          "detail"
        ],
        "properties": {
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
