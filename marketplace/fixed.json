{
  "_comment": "Defaults for the marketplace service's own config file (config.example.json) and its request bounds. The service is deployed separately; none of these are firm settings.",
  "listen": ":8090",
  "data_dir": "/var/lib/togavsu-marketplace",
  "operator_token_file": "/run/secrets/marketplace_operator_token",
  "secure_cookies": true,
  "author_session_hours": 12,
  "operator_session_minutes": 60,
  "read_header_timeout_seconds": 10,
  "max_json_bytes": 65536,
  "min_operator_token_bytes": 32,
  "price_change_notice_days": 30,
  "platform_fee_percent": 0,
  "max_platform_fee_percent": 100,
  "currency_code_length": 3,
  "cents_per_major_unit": 100,
  "interval_year_step": 1,
  "interval_month_step": 1,
  "hours_per_day": 24,
  "stripe_error_log_runes": 200,
  "card_digit_min": 13,
  "card_digit_max": 19,
  "stripe_webhook_tolerance_seconds": 300,
  "stripe_response_max_bytes": 1048576,
  "stripe_checkout_quantity": 1,
  "stripe_api_version": "2024-06-20",
  "mail_retry_interval_seconds": 300,
  "smtp_deadline_seconds": 5,
  "smtp_read_buffer_bytes": 4096,
  "smtp_tmp_buffer_bytes": 1024,
  "default_smtp_from": "marketplace@localhost",
  "stripe_api_base": "",
  "stripe_secret_file": "",
  "stripe_webhook_secret_file": "",
  "license_seed_file": "",
  "smtp_addr": "",
  "smtp_from": "marketplace@localhost"
}
